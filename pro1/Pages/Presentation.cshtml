@page
@model PresentationModel
@{
    ViewData["Title"] = "Танилцуулга Үүсгэх Систем";
}

<style>
    .presentation-container {
        position: relative;
        width: 100%;
        height: 90vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        overflow: hidden;
        border-radius: 10px;
    }

    .presentation-canvas {
        position: absolute;
        width: 100%;
        height: 100%;
        transform-origin: center;
        transition: transform 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    .frame {
        position: absolute;
        width: 400px;
        height: 300px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        padding: 30px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
    }

    .frame:hover {
        transform: scale(1.05);
        box-shadow: 0 15px 50px rgba(0,0,0,0.3);
    }

    .frame h3 {
        margin: 0 0 10px 0;
        font-size: 20px;
        color: #333;
    }

    .frame p {
        margin: 0;
        color: #666;
        font-size: 14px;
    }

    .frame-1 { left: 50%; top: 50%; transform: translate(-50%, -50%); background: #FF6B6B; }
    .frame-2 { left: 10%; top: 20%; background: #4ECDC4; }
    .frame-3 { left: 70%; top: 15%; background: #45B7D1; }
    .frame-4 { left: 50%; top: 70%; background: #FFA07A; }
    .frame-5 { left: 5%; top: 65%; background: #98D8C8; }

    .controls {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 100;
        background: rgba(255,255,255,0.9);
        padding: 15px;
        border-radius: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }

    .controls button {
        padding: 10px 15px;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s;
    }

    .btn-zoom-in, .btn-zoom-out, .btn-reset {
        background: #667eea;
        color: white;
    }

    .btn-zoom-in:hover, .btn-zoom-out:hover, .btn-reset:hover {
        background: #764ba2;
        transform: scale(1.1);
    }

    .btn-presentation {
        background: #FF6B6B;
        color: white;
        font-size: 16px;
    }

    .btn-presentation:hover {
        background: #ee5a52;
    }

    .frame-indicator {
        position: absolute;
        top: 20px;
        right: 20px;
        background: rgba(255,255,255,0.9);
        padding: 10px 15px;
        border-radius: 20px;
        font-weight: bold;
        z-index: 50;
    }

    .sidebar {
        position: fixed;
        left: 20px;
        top: 100px;
        background: white;
        border-radius: 10px;
        padding: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        max-width: 150px;
        z-index: 100;
    }

    .thumbnail {
        width: 100px;
        height: 75px;
        border-radius: 5px;
        margin-bottom: 10px;
        cursor: pointer;
        border: 2px solid #ddd;
        transition: all 0.3s;
    }

    .thumbnail:hover {
        border-color: #667eea;
        transform: scale(1.05);
    }

    .thumbnail-1 { background: #FF6B6B; }
    .thumbnail-2 { background: #4ECDC4; }
    .thumbnail-3 { background: #45B7D1; }
    .thumbnail-4 { background: #FFA07A; }
    .thumbnail-5 { background: #98D8C8; }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <h1 class="mb-4">📊 Танилцуулга Үүсгэх Систем</h1>
            
            <div class="presentation-container">
                <div class="presentation-canvas" id="canvas">
                    <div class="frame frame-1" onclick="zoomToFrame(1)">
                        <h3>🎓 Хичээл 1</h3>
                        <p>Гарга, дасга, үр дүнг авч харуулж байгаа систем</p>
                    </div>
                    <div class="frame frame-2" onclick="zoomToFrame(2)">
                        <h3>📈 Хичээл 2</h3>
                        <p>Анхны ойлголт</p>
                    </div>
                    <div class="frame frame-3" onclick="zoomToFrame(3)">
                        <h3>💡 Хичээл 3</h3>
                        <p>Үндсэн ойлголт</p>
                    </div>
                    <div class="frame frame-4" onclick="zoomToFrame(4)">
                        <h3>🚀 Хичээл 4</h3>
                        <p>Дэвшилтэт сүдэлгээ</p>
                    </div>
                    <div class="frame frame-5" onclick="zoomToFrame(5)">
                        <h3>🎯 Хичээл 5</h3>
                        <p>Эцсийн үнэлгээ</p>
                    </div>
                </div>

                <div class="frame-indicator">
                    <span id="frameCount">Хичээл 1 / 5</span>
                </div>

                <div class="controls">
                    <button class="btn-zoom-out" onclick="zoomOut()">➖ Холуулах</button>
                    <button class="btn-reset" onclick="resetZoom()">🔄 Эргүүлэх</button>
                    <button class="btn-zoom-in" onclick="zoomIn()">➕ Томруулах</button>
                    <button class="btn-presentation" onclick="startPresentation()">▶️ Танилцуулга</button>
                </div>
            </div>

            <div class="sidebar">
                <div class="thumbnail thumbnail-1" onclick="zoomToFrame(1)">1</div>
                <div class="thumbnail thumbnail-2" onclick="zoomToFrame(2)">2</div>
                <div class="thumbnail thumbnail-3" onclick="zoomToFrame(3)">3</div>
                <div class="thumbnail thumbnail-4" onclick="zoomToFrame(4)">4</div>
                <div class="thumbnail thumbnail-5" onclick="zoomToFrame(5)">5</div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentZoom = 1;
    let currentFrame = 1;
    const canvas = document.getElementById('canvas');
    const frames = [
        { frame: 1, scale: 1, x: 0, y: 0 },
        { frame: 2, scale: 2, x: -30, y: -50 },
        { frame: 3, scale: 2.5, x: -70, y: -60 },
        { frame: 4, scale: 2, x: 0, y: -100 },
        { frame: 5, scale: 2, x: 40, y: -80 }
    ];

    function zoomToFrame(frameNum) {
        currentFrame = frameNum;
        const frame = frames[frameNum - 1];
        currentZoom = frame.scale;
        canvas.style.transform = `scale(${frame.scale}) translate(${frame.x}px, ${frame.y}px)`;
        document.getElementById('frameCount').textContent = `Хичээл ${frameNum} / 5`;
    }

    function zoomIn() {
        currentZoom *= 1.2;
        canvas.style.transform = `scale(${currentZoom})`;
    }

    function zoomOut() {
        currentZoom /= 1.2;
        canvas.style.transform = `scale(${currentZoom})`;
    }

    function resetZoom() {
        currentZoom = 1;
        currentFrame = 1;
        canvas.style.transform = `scale(1) translate(0, 0)`;
        document.getElementById('frameCount').textContent = `Хичээл 1 / 5`;
    }

    function startPresentation() {
        alert('Танилцуулга горимыг идэвхжүүлэх болно. Сум товчнуудаар шилжүүлнэ.');
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowRight' && currentFrame < 5) {
                zoomToFrame(currentFrame + 1);
            } else if (e.key === 'ArrowLeft' && currentFrame > 1) {
                zoomToFrame(currentFrame - 1);
            }
        });
    }

    // Wheel zoom
    canvas.parentElement.addEventListener('wheel', function(e) {
        e.preventDefault();
        if (e.deltaY > 0) {
            zoomOut();
        } else {
            zoomIn();
        }
    });
</script>
