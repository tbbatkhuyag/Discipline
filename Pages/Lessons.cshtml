@page
@model LessonsModel
@{
    ViewData["Title"] = "Хичээлийн Сан";
}

<style>
    .lesson-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 20px;
        text-align: center;
        border-radius: 10px;
        margin-bottom: 40px;
    }

    .lesson-hero h1 {
        font-size: 48px;
        margin-bottom: 10px;
    }

    .lesson-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .lesson-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        transition: all 0.3s;
        cursor: pointer;
    }

    .lesson-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .lesson-thumbnail {
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 48px;
        font-weight: bold;
    }

    .lesson-thumbnail-1 { background: linear-gradient(135deg, #FF6B6B, #ee5a52); }
    .lesson-thumbnail-2 { background: linear-gradient(135deg, #4ECDC4, #44a79a); }
    .lesson-thumbnail-3 { background: linear-gradient(135deg, #45B7D1, #3a9ab8); }
    .lesson-thumbnail-4 { background: linear-gradient(135deg, #FFA07A, #ff8656); }
    .lesson-thumbnail-5 { background: linear-gradient(135deg, #98D8C8, #7cc4b0); }

    .lesson-content {
        padding: 20px;
    }

    .lesson-title {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
        color: #333;
    }

    .lesson-description {
        color: #666;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .lesson-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

    .lesson-duration {
        background: #f0f0f0;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
        color: #666;
    }

    .lesson-level {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .lesson-actions {
        display: flex;
        gap: 10px;
    }

    .btn-view {
        flex: 1;
        padding: 10px;
        background: #667eea;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s;
        font-weight: bold;
    }

    .btn-view:hover {
        background: #764ba2;
    }

    .btn-edit {
        padding: 10px 15px;
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffc107;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-edit:hover {
        background: #ffc107;
    }

    .create-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 15px 30px;
        border: none;
        border-radius: 30px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s;
        margin-bottom: 40px;
    }

    .create-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .stat-number {
        font-size: 36px;
        font-weight: bold;
        color: #667eea;
    }

    .stat-label {
        color: #666;
        margin-top: 5px;
    }
</style>

<div class="container mt-5">
    <div class="lesson-hero">
        <h1>📚 Хичээлийн Сан</h1>
        <p>Шагналын танилцуулгын зориулалттай хичээлүүдийг үзэх, бүтээх, засах</p>
    </div>

    <button class="create-btn" onclick="alert('Шинэ хичээл үүсгэх хэсэг')">➕ Шинэ хичээл үүсгэх</button>

    <div class="stats">
        <div class="stat-card">
            <div class="stat-number">5</div>
            <div class="stat-label">Нийт хичээл</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">1,240</div>
            <div class="stat-label">Дүүргэсэн сурагч</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">4.8★</div>
            <div class="stat-label">Дундаж үнэлгээ</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">156</div>
            <div class="stat-label">Танилцуулгын сессүүд</div>
        </div>
    </div>

    <div class="lesson-grid">
        <!-- Lesson 1 -->
        <div class="lesson-card">
            <div class="lesson-thumbnail lesson-thumbnail-1">🎓</div>
            <div class="lesson-content">
                <div class="lesson-title">Гарга, дасга, үр дүнг авч харуулж байгаа систем</div>
                <div class="lesson-description">Үндсэн ойлголт ба санаа санамжээс</div>
                <div class="lesson-meta">
                    <div class="lesson-duration">45 минут</div>
                    <div class="lesson-level">Эхлэгч</div>
                </div>
                <div class="lesson-actions">
                    <button class="btn-view">Үзэх</button>
                    <button class="btn-edit">✏️</button>
                </div>
            </div>
        </div>

        <!-- Lesson 2 -->
        <div class="lesson-card">
            <div class="lesson-thumbnail lesson-thumbnail-2">📈</div>
            <div class="lesson-content">
                <div class="lesson-title">Анхны ойлголт</div>
                <div class="lesson-description">Үндсэн ойлголт ба техник</div>
                <div class="lesson-meta">
                    <div class="lesson-duration">60 минут</div>
                    <div class="lesson-level">Дунд</div>
                </div>
                <div class="lesson-actions">
                    <button class="btn-view">Үзэх</button>
                    <button class="btn-edit">✏️</button>
                </div>
            </div>
        </div>

        <!-- Lesson 3 -->
        <div class="lesson-card">
            <div class="lesson-thumbnail lesson-thumbnail-3">💡</div>
            <div class="lesson-content">
                <div class="lesson-title">Үндсэн ойлголт</div>
                <div class="lesson-description">Гүнзгий сүдэлгээ ба хэрэглээ</div>
                <div class="lesson-meta">
                    <div class="lesson-duration">75 минут</div>
                    <div class="lesson-level">Дунд</div>
                </div>
                <div class="lesson-actions">
                    <button class="btn-view">Үзэх</button>
                    <button class="btn-edit">✏️</button>
                </div>
            </div>
        </div>

        <!-- Lesson 4 -->
        <div class="lesson-card">
            <div class="lesson-thumbnail lesson-thumbnail-4">🚀</div>
            <div class="lesson-content">
                <div class="lesson-title">Дэвшилтэт сүдэлгээ</div>
                <div class="lesson-description">Цогц сүдэлгээ ба төсөл</div>
                <div class="lesson-meta">
                    <div class="lesson-duration">90 минут</div>
                    <div class="lesson-level">Дэвшилтэт</div>
                </div>
                <div class="lesson-actions">
                    <button class="btn-view">Үзэх</button>
                    <button class="btn-edit">✏️</button>
                </div>
            </div>
        </div>

        <!-- Lesson 5 -->
        <div class="lesson-card">
            <div class="lesson-thumbnail lesson-thumbnail-5">🎯</div>
            <div class="lesson-content">
                <div class="lesson-title">Эцсийн үнэлгээ</div>
                <div class="lesson-description">Сургалтыг дүгнэж, үнэлэх</div>
                <div class="lesson-meta">
                    <div class="lesson-duration">30 минут</div>
                    <div class="lesson-level">Бүгдэд</div>
                </div>
                <div class="lesson-actions">
                    <button class="btn-view">Үзэх</button>
                    <button class="btn-edit">✏️</button>
                </div>
            </div>
        </div>
    </div>
</div>
