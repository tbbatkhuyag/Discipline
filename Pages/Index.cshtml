@page
@model IndexModel
@{
    ViewData["Title"] = "Шагналын Танилцуулгын Платформ";
}

<!-- Hero Section -->
<section class="hero bg-primary text-white py-5" data-aos="fade-up" data-aos-duration="1000">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">Гайхалтай Шагналын Танилцуулга Үүсгэх</h1>
                <p class="lead">Таны амжилтыг хүчтэй өгүүлбэр болгон хувиргах. Манай платформ нь үзэгчдийг татах, таны амжилтыг харуулсан мэргэжлийн шагналын танилцуулга бүтээхэд тусална.</p>
                <a href="#features" class="btn btn-light btn-lg">Эхлэх</a>
                <a href="#about" class="btn btn-outline-light btn-lg ms-2">Дэлгэрэнгүй</a>
            </div>
            <div class="col-lg-6">
                <img src="~/images/prize-hero.png" alt="Prize Introduction" class="img-fluid rounded zoom-hover" onerror="this.style.display='none'">
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="py-5" data-aos="zoom-in" data-aos-delay="200">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col">
                <h2 class="display-5">Яагаад Манай Платформыг Сонгох вэ?</h2>
                <p class="lead">Гайхалтай шагналын танилцуулга бүтээхэд хэрэгтэй бүх зүйл</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm zoom-hover" data-aos="fade-up" data-aos-delay="300">
                    <div class="card-body text-center">
                        <i class="bi bi-trophy-fill text-warning fs-1 mb-3"></i>
                        <h5 class="card-title">Мэргэжлийн Загвар</h5>
                        <p class="card-text">Өөр өөр төрлийн шагнал ба амжилтын зориулалттай мэргэжлийн загваруудын олон сонголтоос сонго.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm zoom-hover" data-aos="fade-up" data-aos-delay="400">
                    <div class="card-body text-center">
                        <i class="bi bi-pencil-square text-primary fs-1 mb-3"></i>
                        <h5 class="card-title">Хялбар Тохируулга</h5>
                        <p class="card-text">Манай интуитив редактороор танилцуулгынхаа бүх талбарыг тохируул. Дизайн ур чадвар шаардлагагүй.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm zoom-hover" data-aos="fade-up" data-aos-delay="500">
                    <div class="card-body text-center">
                        <i class="bi bi-share-fill text-success fs-1 mb-3"></i>
                        <h5 class="card-title">Хуваалцах & Экспортлох</h5>
                        <p class="card-text">Өөрийн бүтээлээ шууд хуваалцаж эсвэл танилцуулга, хэвлэлд зориулсан олон форматад экспортло.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="bg-light py-5" data-aos="fade-left" data-aos-duration="1000">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col">
                <h2 class="display-5">Хэрхэн Ажилладаг вэ</h2>
                <p class="lead">Гурван энгийн алхамаар шагналын танилцуулгаа бүтээ</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center" data-aos="zoom-in" data-aos-delay="200">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fs-1 mb-3 zoom-hover" style="width: 80px; height: 80px;">1</div>
                    <h5>Загвар Сонгох</h5>
                    <p>Манай шагналын танилцуулгын загварын цуглуулгаас сонго</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center" data-aos="zoom-in" data-aos-delay="400">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fs-1 mb-3 zoom-hover" style="width: 80px; height: 80px;">2</div>
                    <h5>Агуулгыг Тохируулах</h5>
                    <p>Өөрийн дэлгэрэнгүй мэдээлэл, амжилт нэмж, дизайныг хувийн болго</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center" data-aos="zoom-in" data-aos-delay="600">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fs-1 mb-3 zoom-hover" style="width: 80px; height: 80px;">3</div>
                    <h5>Хуваалцах & Тэмдэглэх</h5>
                    <p>Мэргэжлийн танилцуулгаа хуваалцаж, амжилтаа тэмдэглэ</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-5" data-aos="fade-right" data-aos-duration="1000">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="display-5 mb-4">Шагналын Танилцуулга Тухай</h2>
                <p class="lead mb-4">Бүх амжилт хүчтэй танилцуулгаар тэмдэглэгдэх ёстой. Манай платформ нь таны амжилтыг тодруулж, бусдыг урамшуулсан мэргэжлийн шагналын танилцуулга бүтээхэд мэргэшсэн.</p>
                <p>Та шагнал хүлээн авч байгаа, хурлын үеэр танилцуулж байгаа, эсвэл амжилтын түүхээ хуваалцаж байгаа бай, бид таны мөчийг санамсартай болгох хэрэгслүүдийг өгнө.</p>
                <a href="#features" class="btn btn-primary btn-lg">Бүтээж Эхлэх</a>
            </div>
            <div class="col-lg-6">
                <img src="~/images/prize-about.png" alt="About Prize Introductions" class="img-fluid rounded zoom-hover" onerror="this.style.display='none'">
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="bg-primary text-white py-5" data-aos="zoom-in-up" data-aos-duration="1000">
    <div class="container text-center">
        <h2 class="display-5 mb-3">Шагналын Танилцуулгаа Бүтээхэд Бэлэн үү?</h2>
        <p class="lead mb-4">Амжилтын түүхээ хүчтэй өгүүлбэр болгон хувиргагч мянган хүний нэг бол.</p>
        <a href="/Presentation" class="btn btn-light btn-lg me-3">📊 Танилцуулга үүсгэх</a>
        <a href="/Lessons" class="btn btn-outline-light btn-lg">📚 Хичээлүүдийг үзэх</a>
    </div>
</section>
