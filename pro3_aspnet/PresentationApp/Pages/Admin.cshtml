@page
@model AdminModel
@{
    ViewData["Title"] = "Admin - Presentation Settings";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Presentation Settings</title>
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <div class="admin-header">
            <h1>🎨 Presentation Settings</h1>
            <p>Customize your presentation appearance</p>
        </div>

        <div class="admin-content">
            <!-- Background Color Section -->
            <div class="settings-card">
                <h2>Background Color</h2>
                <p class="description">Choose a solid background color for all slides</p>
                
                <div class="setting-group">
                    <label>Current Background</label>
                    <div class="color-preview" id="colorPreview" style="background-color: @(Model.BackgroundColor ?? "#1e293b")"></div>
                </div>

                <form method="post" enctype="multipart/form-data">
                    <div class="setting-group">
                        <label for="backgroundColor">Select Color:</label>
                        <input type="color" 
                               id="backgroundColor" 
                               name="backgroundColor" 
                               value="@(Model.BackgroundColor ?? "#1e293b")"
                               onchange="updatePreview(this.value)">
                    </div>

                    <div class="setting-group">
                        <label for="backgroundImageFile">Background Image (Optional):</label>
                        <input type="file" id="backgroundImageFile" name="backgroundImageFile" accept="image/*" onchange="previewImage(this)" style="display: block; margin-top: 5px;">
                        @if (!string.IsNullOrEmpty(Model.BackgroundImage))
                        {
                            <div style="margin-top: 15px; background: rgba(0,0,0,0.2); padding: 10px; border-radius: 8px;">
                                <p style="margin-bottom: 5px;">Current Image:</p>
                                <img src="@Model.BackgroundImage" alt="Current Background" style="max-width: 100%; max-height: 200px; border-radius: 4px; border: 1px solid #334155;" id="currentBgImg" />
                                <br>
                                <button type="submit" name="actionType" value="clearImage" class="btn btn-secondary" style="margin-top: 10px; background: #ef4444; color: white;">❌ Remove Image</button>
                            </div>
                        }
                    </div>

                    <div class="preset-colors">
                        <h3>Preset Colors</h3>
                        <div class="color-buttons">
                            <button type="button" class="color-btn" style="background-color: #1e293b" onclick="setColor('#1e293b')">
                                <span>Slate Dark</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #0f172a" onclick="setColor('#0f172a')">
                                <span>Navy Dark</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #1e40af" onclick="setColor('#1e40af')">
                                <span>Blue</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #7c3aed" onclick="setColor('#7c3aed')">
                                <span>Purple</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #dc2626" onclick="setColor('#dc2626')">
                                <span>Red</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #059669" onclick="setColor('#059669')">
                                <span>Green</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #f59e0b" onclick="setColor('#f59e0b')">
                                <span>Amber</span>
                            </button>
                            <button type="button" class="color-btn" style="background-color: #0891b2" onclick="setColor('#0891b2')">
                                <span>Cyan</span>
                            </button>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">💾 Save Settings</button>
                        <a href="/" class="btn btn-secondary">👁️ Preview</a>
                    </div>
                </form>
            </div>

            <!-- Presentation Info -->
            <div class="settings-card">
                <h2>Presentation Info</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <strong>Total Slides:</strong>
                        <span>7</span>
                    </div>
                    <div class="info-item">
                        <strong>Framework:</strong>
                        <span>ASP.NET Core 10.0</span>
                    </div>
                    <div class="info-item">
                        <strong>Engine:</strong>
                        <span>impress.js</span>
                    </div>
                    <div class="info-item">
                        <strong>Last Updated:</strong>
                        <span>May 4, 2026</span>
                    </div>
                </div>
            </div>

            <!-- Preview -->
            <div class="settings-card">
                <h2>Live Preview</h2>
                <div class="preview-section" id="livePreview">
                    <h3>Sample Slide</h3>
                    <p>This is how your slides will look with the selected background color</p>
                    <div class="preview-content">
                        <h4>ASP.NET Core + impress.js</h4>
                        <p>Building Interactive Presentations</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-footer">
            <p>Settings are saved to session and persist during your visit</p>
        </div>
    </div>

    <script>
        function setColor(color) {
            document.getElementById('backgroundColor').value = color;
            updatePreview(color);
        }

        function updatePreview(color) {
            document.getElementById('colorPreview').style.backgroundColor = color;
            document.getElementById('livePreview').style.backgroundColor = color;
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('livePreview').style.backgroundImage = 'url(' + e.target.result + ')';
                    document.getElementById('livePreview').style.backgroundSize = 'cover';
                    document.getElementById('livePreview').style.backgroundPosition = 'center';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Initialize preview
        window.addEventListener('load', function() {
            const color = document.getElementById('backgroundColor').value;
            document.getElementById('livePreview').style.backgroundColor = color;
            
            const currentImg = document.getElementById('currentBgImg');
            if (currentImg) {
                document.getElementById('livePreview').style.backgroundImage = 'url(' + currentImg.src + ')';
                document.getElementById('livePreview').style.backgroundSize = 'cover';
                document.getElementById('livePreview').style.backgroundPosition = 'center';
            }
        });
    </script>
</body>
</html>
